      "id": "unknown_recipient",
      "expectedCode": "UNKNOWN_RECIPIENT",
      "mutation": "s=>s.injects[0].visibleTo=['dtx:missing']"
    },
    {
      "id": "time_out_of_range",
      "expectedCode": "TIME_RANGE",
      "mutation": "s=>s.injects.at(-1).atMinute=s.durationMinutes+1"
    },
    {
      "id": "time_reversed",
      "expectedCode": "TIME_ORDER",
      "mutation": "s=>s.injects[1].atMinute=0"
    },
    {
      "id": "duplicate_task",
      "expectedCode": "DUPLICATE_ID",
      "mutation": "s=>s.tasks.push(structuredClone(s.tasks[0]))"
    },
    {
      "id": "wrong_known_owner",
      "expectedCode": "REFERENCE_OWNER",
      "mutation": "s=>{const a=s.tasks[0],b=s.tasks.find(t=>t.owner!==a.owner);[a.owner,b.owner]=[b.owner,a.owner];}"
    },
    {
      "id": "missing_dependency",
      "expectedCode": "REFERENCE_DEPENDENCY",
      "mutation": "s=>s.tasks.find(t=>t.dependsOn.length).dependsOn=[]"
    },
    {
      "id": "missing_evidence",
      "expectedCode": "SCHEMA",
      "mutation": "s=>s.tasks[0].evidence=[]"
    },
    {
      "id": "unknown_dependency",
      "expectedCode": "UNKNOWN_DEPENDENCY",
      "mutation": "s=>s.tasks[0].dependsOn=['dtx:missing']"
    },
    {
      "id": "unknown_expected_task",
      "expectedCode": "UNKNOWN_TASK",
      "mutation": "s=>s.injects[0].expectedTasks=['dtx:missing']"
    }
  ],
  "invariants": [
    {
      "id": "task_array_order",
      "mutation": "s=>s.tasks.reverse()"
    },
    {
      "id": "relation_set_order",
      "mutation": "s=>{for(const t of s.tasks){t.dependsOn.reverse();t.criteria.reverse();}}"
    }
