{
  "@context": {
    "@version": 1.1,
    "dtx": "https://kimmyungrae80.github.io/drex-disaster-training/ontology#",
    "id": "@id",
    "type": "@type",
    "label": "http://www.w3.org/2000/01/rdf-schema#label",
    "description": "http://purl.org/dc/terms/description",
    "source": "http://purl.org/dc/terms/source",
    "DisasterType": "dtx:DisasterType",
    "RegionFeature": "dtx:RegionFeature",
    "HazardEvent": "dtx:HazardEvent",
    "Organization": "dtx:Organization",
    "Capability": "dtx:Capability",
    "Task": "dtx:Task",
    "Resource": "dtx:Resource",
    "DecisionPoint": "dtx:DecisionPoint",
    "EvaluationCriterion": "dtx:EvaluationCriterion",
    "IssuePattern": "dtx:IssuePattern",
    "CausalRule": "dtx:CausalRule",
    "hasCapability": {"@id": "dtx:hasCapability", "@type": "@id"},
    "hasTask": {"@id": "dtx:hasTask", "@type": "@id"},
    "ownedBy": {"@id": "dtx:ownedBy", "@type": "@id"},
    "dependsOn": {"@id": "dtx:dependsOn", "@type": "@id", "@container": "@set"},
    "requiresResource": {"@id": "dtx:requiresResource", "@type": "@id", "@container": "@set"},
    "mayTrigger": {"@id": "dtx:mayTrigger", "@type": "@id", "@container": "@set"},
    "amplifiedBy": {"@id": "dtx:amplifiedBy", "@type": "@id", "@container": "@set"},
    "mitigatedBy": {"@id": "dtx:mitigatedBy", "@type": "@id", "@container": "@set"},
    "visibleTo": {"@id": "dtx:visibleTo", "@type": "@id", "@container": "@set"},
    "producesEvidence": {"@id": "dtx:producesEvidence", "@container": "@set"},
    "satisfiesCriterion": {"@id": "dtx:satisfiesCriterion", "@type": "@id", "@container": "@set"},
    "conditionAll": {"@id": "dtx:conditionAll", "@type": "@id", "@container": "@set"},
    "conditionAny": {"@id": "dtx:conditionAny", "@type": "@id", "@container": "@set"},
    "createsEvent": {"@id": "dtx:createsEvent", "@type": "@id"},
    "delayThresholdMinutes": {"@id": "dtx:delayThresholdMinutes", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "severityDelta": {"@id": "dtx:severityDelta", "@type": "http://www.w3.org/2001/XMLSchema#decimal"},
    "trainingOnly": {"@id": "dtx:trainingOnly", "@type": "http://www.w3.org/2001/XMLSchema#boolean"}
  }
}
